{
  "manifest_version": 3,
  "name": "My Janitor Theme",
  "version": "1.8",
  "description": "Dynamic ambient engine for Janitor AI chats.",
  "permissions": [
    "webRequest",
    "tabs"
  ],
  "host_permissions": [
    "*://*.janitorai.com/*",
    "https://api.cloudflare.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.janitorai.com/chats/*"],
      "css": ["styles.css"],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["audio/*", "assets.json"],
      "matches": ["*://*.janitorai.com/*"]
    }
  ]
}
