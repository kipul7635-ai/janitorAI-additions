{
  "manifest_version": 3,
  "name": "jAI dynamic ambience",
  "version": "1.3",
  "description": "Dynamic ambient engine for Janitor AI chats.",
  "permissions": ["storage"], 
  "content_scripts": [
    {
      "matches": ["*://*.janitorai.com/chats/*"],
      "css": ["styles.css"],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["images/*", "audio/*", "assets.json"],
      "matches": ["*://*.janitorai.com/*"]
    }
  ]
}
