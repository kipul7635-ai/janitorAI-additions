{
  "manifest_version": 3,
  "name": "JanitorAI ambient engine",
  "version": "1.10",
  "description": "Dynamic ambient effects for Janitor AI chats",
  "icons": {
    "16": "images/extensionIcon.png",
    "48": "images/extensionIcon.png",
    "128": "images/extensionIcon.png"
  },
  "action": {
    "default_icon": "images/extensionIcon.png"
  },
  "permissions": [
    "webRequest",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "*://*.janitorai.com/*",
    "https://api.cloudflare.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.janitorai.com/chats/*"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "audio/*",
        "assets.json",
        "images/tabIcon.png"
      ],
      "matches": [
        "*://*.janitorai.com/*"
      ]
    }
  ]
}
