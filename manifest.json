{
  "manifest_version": 3,
  "name": "My Janitor Theme",
  "version": "1.9",
  "description": "Dynamic ambient engine for Janitor AI chats.",
  "icons": {
    "16": "images/extensionIcon.png",
    "48": "images/extensionIcon.png",
    "128": "images/extensionIcon.png"
  },
  "action": {
    "default_icon": "images/extensionIcon.png"
  },
  "permissions": [
    "webRequest",
    "tabs"
  ],
  "host_permissions": [
    "*://*.janitorai.com/*",
    "https://api.cloudflare.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.janitorai.com/chats/*"],
      "css": ["styles.css"],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["audio/*", "assets.json", "images/tabIcon.png"],
      "matches": ["*://*.janitorai.com/*"]
    }
  ]
}
